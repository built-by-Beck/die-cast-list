# Firebase — frontend (safe to expose in browser)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Stripe Payment Links (create in Stripe Dashboard → Payment Links)
# These are public-facing hosted payment URLs — safe to expose in the browser.
# After a user pays, manually activate their account in Firebase console (Phase 3 automates this via webhooks).
VITE_STRIPE_BASIC_LINK=https://buy.stripe.com/your-basic-link-here
VITE_STRIPE_PREMIUM_LINK=https://buy.stripe.com/your-premium-link-here

# NOTE: NEVER put the following in .env or any frontend file:
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# Firebase Admin SDK service account credentials
# These belong only in Cloud Functions environment variables.
