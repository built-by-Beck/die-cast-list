# Firebase — frontend (safe to expose in browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: region where Cloud Functions are deployed (must match Firebase console)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional: production site URL (defaults to https://diecastlist.com)
VITE_SITE_URL=https://diecastlist.com

# Billing uses the callable Cloud Function `createCheckoutSession` and Stripe webhooks.
# Do not put Stripe secret keys or webhook signing secrets in this file.

# AI (Genkit / Gemini) — set as a Firebase Secret, not a .env file
# firebase functions:secrets:set GOOGLE_GENAI_API_KEY
# Get your key at https://aistudio.google.com/app/apikey
