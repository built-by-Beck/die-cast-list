rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User docs ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users may only read their own doc
      allow read: if request.auth != null && request.auth.uid == userId;

      // Client may create their own doc on registration with strictly safe initial values
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.plan == 'none'
        && request.resource.data.lifetimeAccess == false
        && request.resource.data.stripeCustomerId == null
        && request.resource.data.stripeSubscriptionId == null
        && request.resource.data.subscriptionStatus == null;

      // Client may update their own doc but NEVER touch billing or role fields
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !('plan'                 in request.resource.data.diff(resource.data).affectedKeys())
        && !('role'                 in request.resource.data.diff(resource.data).affectedKeys())
        && !('lifetimeAccess'       in request.resource.data.diff(resource.data).affectedKeys())
        && !('lifetimeAccessReason' in request.resource.data.diff(resource.data).affectedKeys())
        && !('stripeCustomerId'     in request.resource.data.diff(resource.data).affectedKeys())
        && !('stripeSubscriptionId' in request.resource.data.diff(resource.data).affectedKeys())
        && !('subscriptionStatus'   in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── User inventory ────────────────────────────────────────────────────────
    match /usr/{userId}/cars/{carId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /usr/{userId}/photos/{photoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Progress item subdocuments — queried via collectionGroup for duplicates view
    match /{path=**}/progressItems/{itemId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /usr/{userId}/checklistProgress/{checklistId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /progressItems/{itemId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null
          && request.auth.uid == userId
          && (
            !('publicIntentStatus' in request.resource.data)
            || request.resource.data.publicIntentStatus == 'none'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lifetimeAccess == true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'premium'
          );
      }
    }

    match /usr/{userId}/trackedLists/{listId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /marketplaceIntents/{intentId} {
      allow read: if resource.data.isActive == true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lifetimeAccess == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'premium'
        );
    }

    match /usr/{userId}/wanted/{wantedId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /usr/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Master checklists — public read, admin write ───────────────────────────
    match /checklists/{checklistId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /checklists/{checklistId}/items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Admin logs — admin only ────────────────────────────────────────────────
    match /adminLogs/{logId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
